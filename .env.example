# Copy this file to resume_agent/.env and paste your real key.
# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=PASTE_YOUR_KEY_HERE

# FALSE = use the Gemini API directly with the key above (simplest).
# TRUE  = route through Vertex AI (needs a GCP project + gcloud auth).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# LangGraph + OpenRouter. OPENROUTER_API_KEY is also accepted.
OPENROUTER=

# Optional LangSmith tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=rolefit-resume-agent
